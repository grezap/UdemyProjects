@page "/editproduct/{id:int}"
@rendermode InteractiveServer 

<h3>Edit Product</h3>
<br />

@if(_product != null)
{
    <EditForm Model="_product" OnValidSubmit="Update">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>

        <div class="form-group">
            <label for="name">Product Name</label>
            <InputText id="name" @bind-Value="_product.ProductName" class="form-control"></InputText>
            <ValidationMessage For="() => _product.ProductName"></ValidationMessage>
        </div>
        <div class="form-group">
            <label for="quantity">Quantity</label>
            <InputNumber id="quantity" @bind-Value="_product.Quantity" class="form-control"></InputNumber>
            <ValidationMessage For="() => _product.Quantity"></ValidationMessage>
        </div>
        <div class="form-group">
            <label for="price">Price</label>
            <InputNumber id="price" @bind-Value="_product.Price" class="form-control"></InputNumber>
            <ValidationMessage For="() => _product.Price"></ValidationMessage>
        </div>
        <div class="form-group">
            <label for="inventories">Inventories</label>
            <ProductInventoriesComponent Product="_product"></ProductInventoriesComponent>
        </div>
        <br />
        <button type="submit" class="btn btn-primary">Update</button>
        &nbsp;
        <a href="/products" class="btn btn-primary">Cancel</a>
    </EditForm>
}



